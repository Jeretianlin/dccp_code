# ============================================
# DCCP Server Configuration
# ============================================
# Copy this file to config.env and modify as needed
# ============================================

# ----------------------------------------
# Server Settings
# ----------------------------------------

# Server port (default: 3000)
PORT=3000

# ----------------------------------------
# JWT Settings
# ----------------------------------------

# JWT secret key (IMPORTANT: Change this in production!)
# Use a strong random string (at least 32 characters)
JWT_SECRET=your-secret-key-change-me-in-production

# JWT token expiration (default: 7d)
# Examples: 1h, 24h, 7d, 30d
JWT_EXPIRES_IN=7d

# ----------------------------------------
# Database Settings (MySQL Required)
# ----------------------------------------

# Database connection URL
# Database: dccp
# Username: dccp_user
# Password: DccpUser123
DATABASE_URL=mysql://dccp_user:DccpUser123@localhost:3306/dccp

# Note: Run scripts\create-admin.sql first to create database and user
# Command: mysql -u root -p < scripts\create-admin.sql

# ----------------------------------------
# HTTPS Configuration
# ----------------------------------------

# Enable HTTPS (recommended for production)
HTTPS_ENABLED=true

# SSL certificate paths (relative to installation directory)
# Place your certificate files in the certs/ directory
HTTPS_KEY_PATH=./certs/key.pem
HTTPS_CERT_PATH=./certs/cert.pem

# For development/testing without HTTPS:
# HTTPS_ENABLED=false

# ----------------------------------------
# Data Storage
# ----------------------------------------

# Data directory (relative to installation path)
DATA_DIR=./data

# ----------------------------------------
# Upload Settings
# ----------------------------------------

# Upload chunk size in bytes (default: 5MB)
UPLOAD_CHUNK_SIZE=5242880

# ----------------------------------------
# Prisma Engine Settings (Auto-configured)
# ----------------------------------------
# These are automatically set by start-server.bat or install-service.bat
# You normally don't need to change these.
#
# PRISMA_QUERY_ENGINE_LIBRARY=./prisma-engines/query_engine-windows.dll.node
# PRISMA_SCHEMA_ENGINE=./prisma-engines/schema-engine-windows.exe

# ============================================
# Quick Setup Checklist:
# ============================================
# 1. Install MySQL
# 2. Run: mysql -u root -p < scripts\create-admin.sql
#    (Creates database 'dccp' and user 'dccp_user')
# 3. Copy this file to config.env
# 4. Change JWT_SECRET to a strong random string
# 5. Place SSL certificates in certs/ directory
#    (Or set HTTPS_ENABLED=false for testing)
# 6. Run scripts\init-db.bat to create tables
# 7. Run start-server.bat to start directly
#    OR run install-service.bat to install as Windows service
# ============================================