{
  "name": "@dccp/server",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "bin": "./dist/index.js",
  "pkg": {
    "name": "dccp-server",
    "targets": ["node18-win-x64"],
    "outputPath": "build",
    "assets": ["dist/**/*"]
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "dotenv -e config.env -- prisma generate",
    "db:push": "dotenv -e config.env -- prisma db push",
    "db:studio": "dotenv -e config.env -- prisma studio",
    "db:migrate": "dotenv -e config.env -- prisma migrate dev",
    "build:exe": "npm run build && npx pkg . --output build/dccp-server.exe",
    "build:win": "npm run build && npx pkg . --output build/dccp-server.exe"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "archiver": "^5.3.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.20.0",
    "node-cron": "^3.0.3",
    "selfsigned": "^5.5.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "@yao-pkg/pkg": "^6.14.1",
    "dotenv-cli": "^7.0.0",
    "prisma": "^5.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}